# Copy to .env. Every value is required; compose refuses to start otherwise.

# Generate each key with:  openssl rand -base64 32
# The two keys must differ (the portal enforces this at startup).
PORTAL_SESSION_KEY=
PORTAL_SESSION_KEY_ID=session-v1
PORTAL_ENCRYPTION_KEY=
PORTAL_ENCRYPTION_KEY_ID=pii-v1

# Pocket ID v2 encrypts its own secrets at rest and will not start without
# this. Generate with:  openssl rand -base64 24
POCKET_ID_ENCRYPTION_KEY=

# From Pocket ID: start it (docker compose up -d pocket-id), open
# http://pocket-id.localhost:1411/setup and create the admin account, then
# create an OIDC client with callback URL
# http://localhost:8080/auth/callback and paste its credentials here.
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=

# From Stripe: the organization sandbox key (sk_org_test_...) and the two
# account identifiers (Dashboard → Organization → accounts).
PORTAL_STRIPE_SECRET_KEY=
PORTAL_STRIPE_MEMBERSHIPS_ACCOUNT=
PORTAL_STRIPE_DONATIONS_ACCOUNT=

# One webhook endpoint per Stripe account, each with its own signing secret.
# Two endpoints rather than one is what makes the cross-account check
# enforceable: an event delivered to the wrong endpoint fails its signature,
# so donations can never be projected into the membership ledger. The portal
# refuses to start if these are equal.
#
# In each account's Dashboard → Developers → Webhooks, add an endpoint:
#
#   memberships  <base-url>/stripe/webhook/memberships
#   donations    <base-url>/stripe/webhook/donations
#
# Select exactly the events the projector acts on, and no others. Anything
# else is stored and then ignored, which is safe but turns the inbox into
# noise that hides the events that matter:
#
#   checkout.session.completed     checkout.session.expired
#   invoice.paid                   customer.subscription.updated
#   customer.subscription.deleted
#
# Not payment_intent.succeeded: payments here originate from a card-pinned
# Checkout Session and settle synchronously, so it carries nothing
# checkout.session.completed does not.
#
# Set each endpoint's API version to the one the binary expects — run
# `grep ExpectedAPIVersion internal/stripepay/webhook.go`. A mismatch is
# refused with its own error rather than read as a forged signature.
#
# Locally, Stripe cannot reach localhost. Use the Stripe CLI, which prints a
# whsec_... to paste here:
#   stripe listen --forward-to localhost:8080/stripe/webhook/memberships
PORTAL_STRIPE_MEMBERSHIPS_WEBHOOK_SECRET=
PORTAL_STRIPE_DONATIONS_WEBHOOK_SECRET=
